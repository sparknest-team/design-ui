{
  "name": "@loca/design-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "design-system-check": "./bin/spec-check.mjs"
  },
  "scripts": {
    "check:cedar": "node bin/spec-check.mjs --config configs/cedar.json",
    "check:maple": "node bin/spec-check.mjs --config configs/maple.json",
    "check:tokens": "node bin/token-diff.mjs && node bin/token-diff.mjs --component badge --strict",
    "check": "pnpm check:cedar && pnpm check:maple && pnpm check:tokens"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b"
}
