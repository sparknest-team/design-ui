{
  "name": "cedar-design-web-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:lib && pnpm build:doc",
    "build:lib": "pnpm --filter @cedar-design/shared build && pnpm --filter @cedar-design/use build && pnpm --filter @cedar-design/icons-vue build && pnpm --filter @cedar-design/resolver build && pnpm build:presets && pnpm --filter @cedar-design/ui build:lib",
    "build:doc": "pnpm --filter @cedar-design/ui build:doc",
    "build:presets": "pnpm --filter @cedar-design/preset-unocss build && pnpm --filter @cedar-design/preset-tailwindcss build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "dev": "pnpm --filter @cedar-design/ui dev",
    "test": "pnpm --filter @cedar-design/ui test",
    "test:watch": "pnpm --filter @cedar-design/ui test:watch",
    "typecheck": "pnpm --filter @cedar-design/ui typecheck && pnpm --dir packages/cedar-ui exec vue-tsc --noEmit -p tsconfig.p1-api.json",
    "spec:check": "node scripts/quality/spec-check.mjs",
    "package:check": "node scripts/quality/package-check.mjs",
    "quality": "pnpm check:shared && pnpm check:runtime-dependencies && pnpm build:lib && pnpm spec:check && pnpm check:style-vars && pnpm lint && pnpm typecheck && pnpm test && pnpm check:direction && pnpm check:cli && pnpm check:resolver && pnpm check:doc-pipeline && pnpm build:doc && pnpm package:check && pnpm check:published-environment && pnpm check:docs-theme && pnpm check:docs-components && pnpm check:compatibility",
    "check:doc-pipeline": "node --test ../design-ui/bin/llms-docs.test.mjs ../design-ui/bin/group-demo-sections.test.mjs ../design-ui/bin/group-maple-examples.test.mjs ../design-ui/bin/compose-demo-comparison.test.mjs ../design-ui/bin/demo-config-comparison.test.mjs ../design-ui/bin/demo-content-parity.test.mjs ../design-ui/bin/api-documentation-locales.test.mjs && pnpm --dir packages/cedar-ui exec vitest run --config docs/.vuepress/vitest.config.ts --threads=false",
    "check:docs-theme": "node --test scripts/browser/docs-theme.test.mjs",
    "check:docs-components": "node --test scripts/browser/components.test.mjs",
    "check:published-environment": "node ../design-ui/bin/published-environment-check.mjs",
    "check:cli": "pnpm --filter @cedar-design/cli test",
    "check:resolver": "pnpm --filter @cedar-design/resolver test",
    "check:shared": "node --test scripts/quality/shared-bundle.test.mjs",
    "check:runtime-dependencies": "node scripts/quality/runtime-dependency-check.mjs && pnpm --dir packages/cedar-ui exec vitest run --config site-imports.vitest.config.ts --threads=false",
    "format": "pnpm --filter @cedar-design/ui format",
    "lint": "pnpm --filter @cedar-design/ui lint",
    "icons:build": "pnpm --filter @cedar-design/icons-vue build",
    "icons:check": "pnpm --filter @cedar-design/icons-vue generate:check",
    "ui:gen": "pnpm --filter @cedar-design/ui ui:gen",
    "dtsgen": "pnpm --filter @cedar-design/ui dtsgen",
    "watch": "pnpm --filter @cedar-design/ui watch",
    "clean-cache": "pnpm --filter @cedar-design/ui clean-cache",
    "preview": "pnpm --filter @cedar-design/ui preview",
    "release": "node scripts/release.mjs",
    "prepare": "husky install packages/cedar-ui/.husky",
    "postinstall": "patch-package --patch-dir packages/cedar-ui/patches",
    "check:tabs": "node checks/tabs-same-source.mjs",
    "check:rate": "node checks/rate-same-source.mjs",
    "check:ripple": "node checks/ripple-same-source.mjs",
    "check:lightweight-feedback": "node checks/lightweight-feedback-same-source.mjs",
    "check:input": "node checks/input-same-source.mjs",
    "check:selection-field": "node checks/selection-field-same-source.mjs",
    "check:selection-presentations": "node checks/selection-presentations-same-source.mjs",
    "check:auto-complete": "node checks/auto-complete-same-source.mjs",
    "check:time-rules": "node checks/time-rules-same-source.mjs",
    "check:form-kernel": "node checks/form-kernel-same-source.mjs",
    "check:style-vars": "node checks/style-vars-contract.mjs",
    "check:date-family": "node checks/date-family-same-source.mjs",
    "check:scroll-text": "node checks/scroll-text-same-source.mjs",
    "check:api-naming": "node ../design-ui/bin/api-naming-check.mjs",
    "check:compatibility": "node ../design-ui/browser/matrix.mjs cedar",
    "compatibility:native:init": "node ../design-ui/browser/native-acceptance.mjs cedar --init",
    "check:compatibility:release": "node ../design-ui/browser/native-acceptance.mjs cedar",
    "check:direction": "pnpm --dir packages/cedar-ui exec vitest run src/_utils/__tests__/reading-direction.spec.js src/table/__tests__/reading-direction.spec.ts --threads=false"
  },
  "packageManager": "pnpm@9.6.0",
  "devDependencies": {
    "@cedar-design/cli": "workspace:*",
    "@sparknest/theme-contract": "link:../design-ui/packages/theme-contract",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "nanospinner": "^1.2.2",
    "playwright": "1.62.0",
    "tinyexec": "npm:tinyexec@^0.3.0"
  },
  "engines": {
    "pnpm": ">=9.6.0"
  }
}
