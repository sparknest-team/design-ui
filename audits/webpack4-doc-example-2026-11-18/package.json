{
  "name": "webpack4-doc-validation",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@cedar-design/icons-vue": "1.1.11",
    "@cedar-design/ui-vue": "1.1.11",
    "@maple-design/icons-vue": "1.1.11",
    "@maple-design/ui-vue": "1.1.11",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.29.14",
    "babel-loader": "8.4.1",
    "css-loader": "5.2.7",
    "jsdom": "24.1.3",
    "style-loader": "2.0.0",
    "webpack": "4.47.0",
    "webpack-cli": "3.3.12"
  },
  "scripts": {
    "build:maple": "cd maple && webpack --config webpack.config.cjs",
    "build:cedar": "cd cedar && webpack --config webpack.config.cjs",
    "verify:maple": "npm run build:maple && cd maple && node ../verify.cjs",
    "verify:cedar": "npm run build:cedar && cd cedar && node ../verify.cjs",
    "check:docs": "node check-docs.cjs"
  }
}
